{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rocketpad",
  "compatibility_date": "2026-09-01",
  // Site 100% estático: o Worker apenas serve os arquivos de ./public
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
