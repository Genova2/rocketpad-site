{
  "name": "dsh-azure-devops",
  "version": "0.1.0",
  "description": "DeepSeek Harness bundle: policy layer and workflow skill for the official Azure DevOps MCP server",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "skills"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "azure-devops",
    "mcp"
  ],
  "scripts": {
